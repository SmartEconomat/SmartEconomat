# ============================================================================
# SmartEconomat - Plantilla de variables de entorno
# Copia este archivo a .env.dev o .env.prod y ajusta valores por entorno.
# ============================================================================

# --- Entorno general ---
NODE_ENV=development
DOMAIN=localhost

# --- Backend/API ---
BACKEND_PORT=3000

# --- Frontend ---
FRONTEND_PORT=5173
VITE_SENTRY_DSN=

# --- Observabilidad ---
SENTRY_DSN=

# --- JWT/Auth ---
JWT_SECRET=changeme
JWT_EXPIRATION=7d

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5432

DB_HOST=db
# Mantener en false para producción. Solo usar true en entorno local temporal.
DB_SYNC=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# --- I18N ---
I18N_PATH=
I18N_FALLBACK_LANGUAGE=es

# --- Mail/SMTP ---
# Dejar vacío para usar modo simulación (logs)
# Para Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, usar contraseña de aplicación
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false

# --- Seeders / bootstrap ---
SEED_DEFAULT_ADMIN_TEMP_PASSWORD=
SEED_BOOTSTRAP_ADMIN_EMAIL=
SEED_BOOTSTRAP_ADMIN_USERNAME=superadmin
SEED_BOOTSTRAP_ADMIN_PASSWORD=
SEED_API_BASE_URL=
SEED_DOCKER_COMPOSE_FILE=
SEED_LOG_DIR=
SEED_MOVIMIENTOS_GET_ONLY=
SEED_MOVIMIENTOS_GET=
SEED_ONLY_DOMAIN=
SEED_RUN_TAG=
SEED_MULTIPLIER=
SEEDER_LANG=es
IS_SEEDING=false
RUN_BOOTSTRAP_SEEDER=false
STARTUP_RUN_MIGRATIONS=false

# --- OpenFoodFacts ---
OPEN_FOOD_FACTS_PROXY_REQUEST_DELAY_MS=1200
OPEN_FOOD_FACTS_REQUEST_DELAY_MS=
OPEN_FOOD_FACTS_PROXY_TIMEOUT_MS=15000
OPEN_FOOD_FACTS_TIMEOUT_MS=
OPEN_FOOD_FACTS_IMAGE_TIMEOUT_MS=20000

# --- Runtime local ---
OFF_API_ENABLED=false
LOCAL_STORAGE_PATH=./uploads

# --- TLS/Deploy ---
TLS_PROVIDER=selfsigned
TLS_SELF_SIGNED_DAYS=825
LETSENCRYPT_EMAIL=
LETSENCRYPT_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
CERTS_DIR=./certs
CERTS_WEBROOT_DIR=./certs-webroot

# --- ElectronInstaller (runtime/build) ---
DEBUG=
DEBUG_RUN_ID=
INSTALLER_EXIT_ON_FATAL=
ELECTRON_RENDERER_URL=
FORCE_NATIVE_REBUILD=0
PREBUILD_PARALLEL=0
SMART_HTTP_PORT=80
SMART_HTTPS_PORT=443
VERIFY_WIN_EXE_PATH=
SIGNTOOL_PATH=
WIN_TIMESTAMP_URL=http://timestamp.digicert.com
WIN_SIGN_DESCRIPTION=SmartEconomat Installer
WIN_CSC_PFX_PATH=
WIN_CSC_PFX_PASSWORD=
WIN_CSC_PFX_SHA1=
WIN_CSC_THUMBPRINT=
BUILD_WIN_RETRIES=2
BUILD_WIN_TIMEOUT_MS=2700000
BUILD_WIN_RETRY_DELAY_MS=20000
BUILD_STAGE_TIMEOUT_MS=1200000
BUILD_MAX_ATTEMPTS=2
NODE_OPTIONS=--max-old-space-size=4096
CI=false

# --- Ejemplo para producción (Azure/dominio personalizado) ---
# DOMAIN=midominio.com
# DB_HOST=azure-db-host
# SENTRY_DSN=...
# VITE_SENTRY_DSN=...
# TLS_PROVIDER=selfsigned
# TLS_SELF_SIGNED_DAYS=825
# LETSENCRYPT_EMAIL=admin@midominio.com
# LETSENCRYPT_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
