
# --- Variables generales ---
NODE_ENV=development
DOMAIN=localhost

# --- Backend ---
BACKEND_PORT=3000
BACKEND_API_URL=http://localhost:3000

# --- Base de datos ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=app_db
# Mantener en false para producción. Solo usar true en entorno local temporal.
DB_SYNC=false

# --- Frontend ---
FRONTEND_PORT=5173
FRONTEND_API_URL=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:3000

# --- Sentry ---
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- JWT ---
JWT_SECRET=changeme
JWT_EXPIRATION=7d
SEED_DEFAULT_ADMIN_TEMP_PASSWORD=

# --- Email/SMTP ---
# Dejar vacío para activar modo simulación (el enlace de reset se imprime en logs del backend).
# En producción (NODE_ENV=production) las tres variables son OBLIGATORIAS:
#   si faltan, el endpoint forgot-password devuelve 500 en lugar de silenciar el error.
#
# Gmail: activa 2FA → myaccount.google.com/apppasswords → genera contraseña de 16 chars.
#   MAIL_FROM debe coincidir con MAIL_USER (o ser un alias configurado en "Enviar como").
#
# Otros proveedores: Mailgun (smtp.mailgun.org:587), SendGrid (smtp.sendgrid.net:587),
#   Office 365 (smtp.office365.com:587), Mailtrap solo dev (sandbox.smtp.mailtrap.io:2525).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@smarteconomat.com

# --- Ejemplo para producción (Azure/domino personalizado) ---
# DOMAIN=midominio.com
# BACKEND_API_URL=https://api.midominio.com
# FRONTEND_API_URL=https://app.midominio.com
# VITE_API_PROXY_TARGET=https://api.midominio.com
# DB_HOST=azure-db-host
# SENTRY_DSN=...
# VITE_SENTRY_DSN=...
# TLS_PROVIDER=selfsigned
# TLS_SELF_SIGNED_DAYS=825
# LETSENCRYPT_EMAIL=smarteconomat@gmail.com
# LETSENCRYPT_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# --- Ejemplo para produccion local HTTPS ---
# DOMAIN=smarteconomat.app
# BACKEND_API_URL=https://smarteconomat.app/api/v1
# FRONTEND_API_URL=https://smarteconomat.app
# TLS_PROVIDER=selfsigned
# DB_SYNC=false
