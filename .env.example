
# --- Variables generales ---
NODE_ENV=development
DOMAIN=localhost

# --- Backend ---
BACKEND_PORT=3000
BACKEND_API_URL=http://localhost:3000

# --- Base de datos ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=app_db

# --- Frontend ---
FRONTEND_PORT=5173
FRONTEND_API_URL=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:3000

# --- Sentry ---
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- JWT ---
JWT_SECRET=changeme
JWT_EXPIRATION=7d

# --- Ejemplo para producción (Azure/domino personalizado) ---
# DOMAIN=midominio.com
# BACKEND_API_URL=https://api.midominio.com
# FRONTEND_API_URL=https://app.midominio.com
# VITE_API_PROXY_TARGET=https://api.midominio.com
# DB_HOST=azure-db-host
# SENTRY_DSN=...
# VITE_SENTRY_DSN=...
