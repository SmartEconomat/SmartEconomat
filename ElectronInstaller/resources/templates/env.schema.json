{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "NODE_ENV",
    "DOMAIN",
    "SMARTECONOMAT_ENV_FILE",
    "BACKEND_PORT",
    "FRONTEND_PORT",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "DB_HOST",
    "DB_SYNC",
    "JWT_SECRET",
    "JWT_EXPIRATION",
    "SEED_DEFAULT_ADMIN_TEMP_PASSWORD",
    "SEED_DEFAULT_ADMIN_USER_TEMP_PASSWORD",
    "SEED_DEFAULT_ADMIN_USERNAME",
    "SEED_DEFAULT_ADMIN_EMAIL",
    "SEED_DEFAULT_SUPERADMIN_USERNAME",
    "SEED_DEFAULT_SUPERADMIN_EMAIL",
    "SEED_DEFAULT_SUPERADMIN_TEMP_PASSWORD",
    "SEED_DEFAULT_USERS_SYNCED",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "INSTANCE_NAME",
    "ADMIN_USERNAME",
    "TIMEZONE",
    "I18N_PATH",
    "I18N_FALLBACK_LANGUAGE",
    "TLS_PROVIDER",
    "TLS_CUSTOM_FULLCHAIN_PATH",
    "TLS_CUSTOM_PRIVKEY_PATH",
    "TLS_SELF_SIGNED_DAYS",
    "LETSENCRYPT_EMAIL",
    "LETSENCRYPT_DIRECTORY_URL",
    "BACKUP_FREQUENCY",
    "BACKUP_RETENTION_DAYS",
    "CERTS_DIR",
    "CERTS_WEBROOT_DIR",
    "STARTUP_RUN_MIGRATIONS",
    "SENTRY_DSN",
    "VITE_SENTRY_DSN",
    "FRONTEND_HTTP_PORT",
    "FRONTEND_HTTPS_PORT",
    "RUN_BOOTSTRAP_SEEDER",
    "MAIL_HOST",
    "MAIL_PORT",
    "MAIL_USER",
    "MAIL_PASS",
    "MAIL_SECURE",
    "MAIL_FROM",
    "OPEN_FOOD_FACTS_PROXY_REQUEST_DELAY_MS",
    "OPEN_FOOD_FACTS_REQUEST_DELAY_MS",
    "OPEN_FOOD_FACTS_PROXY_TIMEOUT_MS",
    "OPEN_FOOD_FACTS_TIMEOUT_MS",
    "OPEN_FOOD_FACTS_IMAGE_TIMEOUT_MS",
    "OFF_API_ENABLED",
    "LOCAL_STORAGE_PATH",
    "SEED_BOOTSTRAP_ADMIN_EMAIL",
    "SEED_BOOTSTRAP_ADMIN_USERNAME",
    "SEED_BOOTSTRAP_ADMIN_PASSWORD",
    "SEED_API_BASE_URL",
    "SEED_DOCKER_COMPOSE_FILE",
    "SEED_LOG_DIR",
    "SEED_MOVIMIENTOS_GET_ONLY",
    "SEED_MOVIMIENTOS_GET",
    "SEED_ONLY_DOMAIN",
    "SEED_RUN_TAG",
    "SEED_MULTIPLIER",
    "SEEDER_LANG",
    "IS_SEEDING"
  ],
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "enum": ["production"]
    },
    "DOMAIN": {
      "type": "string",
      "minLength": 3
    },
    "SMARTECONOMAT_ENV_FILE": {
      "type": "string",
      "minLength": 1
    },
    "BACKEND_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "FRONTEND_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "POSTGRES_USER": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$"
    },
    "POSTGRES_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "POSTGRES_DB": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "POSTGRES_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "DB_HOST": {
      "type": "string",
      "minLength": 1
    },
    "DB_SYNC": {
      "type": "string",
      "enum": ["false"]
    },
    "JWT_SECRET": {
      "type": "string",
      "minLength": 32
    },
    "JWT_EXPIRATION": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "SEED_DEFAULT_ADMIN_TEMP_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "SEED_DEFAULT_ADMIN_USER_TEMP_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "SEED_DEFAULT_ADMIN_USERNAME": {
      "type": "string",
      "minLength": 4
    },
    "SEED_DEFAULT_ADMIN_EMAIL": {
      "type": "string",
      "minLength": 3
    },
    "SEED_DEFAULT_SUPERADMIN_USERNAME": {
      "type": "string",
      "minLength": 4
    },
    "SEED_DEFAULT_SUPERADMIN_EMAIL": {
      "type": "string",
      "minLength": 3
    },
    "SEED_DEFAULT_SUPERADMIN_TEMP_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "SEED_DEFAULT_USERS_SYNCED": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "REDIS_HOST": {
      "type": "string",
      "minLength": 1
    },
    "REDIS_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "REDIS_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "INSTANCE_NAME": {
      "type": "string",
      "minLength": 3
    },
    "ADMIN_USERNAME": {
      "type": "string",
      "minLength": 4
    },
    "TIMEZONE": {
      "type": "string",
      "minLength": 3
    },
    "I18N_PATH": {
      "type": "string"
    },
    "I18N_FALLBACK_LANGUAGE": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "TLS_PROVIDER": {
      "type": "string",
      "enum": ["selfsigned", "none", "custom", "letsencrypt"]
    },
    "TLS_CUSTOM_FULLCHAIN_PATH": {
      "type": "string"
    },
    "TLS_CUSTOM_PRIVKEY_PATH": {
      "type": "string"
    },
    "TLS_SELF_SIGNED_DAYS": {
      "type": "string",
      "pattern": "^[0-9]{1,4}$"
    },
    "LETSENCRYPT_EMAIL": {
      "type": "string"
    },
    "LETSENCRYPT_DIRECTORY_URL": {
      "type": "string",
      "minLength": 8
    },
    "BACKUP_FREQUENCY": {
      "type": "string",
      "enum": ["off", "daily", "weekly"]
    },
    "BACKUP_RETENTION_DAYS": {
      "type": "string",
      "pattern": "^[0-9]{1,3}$"
    },
    "CERTS_DIR": {
      "type": "string",
      "minLength": 1
    },
    "CERTS_WEBROOT_DIR": {
      "type": "string",
      "minLength": 1
    },
    "STARTUP_RUN_MIGRATIONS": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "RUN_BOOTSTRAP_SEEDER": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "SENTRY_DSN": {
      "type": "string"
    },
    "VITE_SENTRY_DSN": {
      "type": "string"
    },
    "FRONTEND_HTTP_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "FRONTEND_HTTPS_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "MAIL_HOST": {
      "type": "string"
    },
    "MAIL_PORT": {
      "type": "string"
    },
    "MAIL_USER": {
      "type": "string"
    },
    "MAIL_PASS": {
      "type": "string"
    },
    "MAIL_SECURE": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "MAIL_FROM": {
      "type": "string"
    },
    "OPEN_FOOD_FACTS_PROXY_REQUEST_DELAY_MS": {
      "type": "string",
      "pattern": "^[0-9]{1,6}$"
    },
    "OPEN_FOOD_FACTS_REQUEST_DELAY_MS": {
      "type": "string"
    },
    "OPEN_FOOD_FACTS_PROXY_TIMEOUT_MS": {
      "type": "string",
      "pattern": "^[0-9]{1,6}$"
    },
    "OPEN_FOOD_FACTS_TIMEOUT_MS": {
      "type": "string"
    },
    "OPEN_FOOD_FACTS_IMAGE_TIMEOUT_MS": {
      "type": "string",
      "pattern": "^[0-9]{1,6}$"
    },
    "OFF_API_ENABLED": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "LOCAL_STORAGE_PATH": {
      "type": "string",
      "minLength": 1
    },
    "SEED_BOOTSTRAP_ADMIN_EMAIL": {
      "type": "string"
    },
    "SEED_BOOTSTRAP_ADMIN_USERNAME": {
      "type": "string"
    },
    "SEED_BOOTSTRAP_ADMIN_PASSWORD": {
      "type": "string"
    },
    "SEED_API_BASE_URL": {
      "type": "string"
    },
    "SEED_DOCKER_COMPOSE_FILE": {
      "type": "string"
    },
    "SEED_LOG_DIR": {
      "type": "string"
    },
    "SEED_MOVIMIENTOS_GET_ONLY": {
      "type": "string"
    },
    "SEED_MOVIMIENTOS_GET": {
      "type": "string"
    },
    "SEED_ONLY_DOMAIN": {
      "type": "string"
    },
    "SEED_RUN_TAG": {
      "type": "string"
    },
    "SEED_MULTIPLIER": {
      "type": "string"
    },
    "SEEDER_LANG": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "IS_SEEDING": {
      "type": "string",
      "enum": ["true", "false"]
    }
  }
}
