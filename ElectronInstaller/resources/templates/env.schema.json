{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "NODE_ENV",
    "DOMAIN",
    "SMARTECONOMAT_ENV_FILE",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "DB_HOST",
    "DB_SYNC",
    "JWT_SECRET",
    "JWT_EXPIRATION",
    "SEED_DEFAULT_ADMIN_TEMP_PASSWORD",
    "SEED_DEFAULT_ADMIN_USER_TEMP_PASSWORD",
    "SEED_DEFAULT_ADMIN_USERNAME",
    "SEED_DEFAULT_SUPERADMIN_USERNAME",
    "SEED_DEFAULT_SUPERADMIN_TEMP_PASSWORD",
    "SEED_DEFAULT_USERS_SYNCED",
    "REDIS_PASSWORD",
    "INSTANCE_NAME",
    "ADMIN_USERNAME",
    "TIMEZONE",
    "TLS_PROVIDER",
    "TLS_CUSTOM_FULLCHAIN_PATH",
    "TLS_CUSTOM_PRIVKEY_PATH",
    "BACKUP_FREQUENCY",
    "BACKUP_RETENTION_DAYS",
    "CERTS_DIR",
    "CERTS_WEBROOT_DIR",
    "STARTUP_RUN_MIGRATIONS",
    "SENTRY_DSN",
    "VITE_SENTRY_DSN",
    "FRONTEND_HTTP_PORT",
    "FRONTEND_HTTPS_PORT",
    "RUN_BOOTSTRAP_SEEDER"
  ],
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "enum": ["production"]
    },
    "DOMAIN": {
      "type": "string",
      "minLength": 3
    },
    "SMARTECONOMAT_ENV_FILE": {
      "type": "string",
      "minLength": 1
    },
    "POSTGRES_USER": {
      "type": "string",
      "minLength": 1
    },
    "POSTGRES_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "POSTGRES_DB": {
      "type": "string",
      "minLength": 1
    },
    "POSTGRES_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "DB_HOST": {
      "type": "string",
      "minLength": 1
    },
    "DB_SYNC": {
      "type": "string",
      "enum": ["false"]
    },
    "JWT_SECRET": {
      "type": "string",
      "minLength": 32
    },
    "JWT_EXPIRATION": {
      "type": "string",
      "minLength": 2
    },
    "SEED_DEFAULT_ADMIN_TEMP_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "SEED_DEFAULT_ADMIN_USER_TEMP_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "SEED_DEFAULT_ADMIN_USERNAME": {
      "type": "string",
      "minLength": 4
    },
    "SEED_DEFAULT_SUPERADMIN_USERNAME": {
      "type": "string",
      "minLength": 4
    },
    "SEED_DEFAULT_SUPERADMIN_TEMP_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "SEED_DEFAULT_USERS_SYNCED": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "REDIS_PASSWORD": {
      "type": "string",
      "minLength": 12
    },
    "INSTANCE_NAME": {
      "type": "string",
      "minLength": 3
    },
    "ADMIN_USERNAME": {
      "type": "string",
      "minLength": 4
    },
    "TIMEZONE": {
      "type": "string",
      "minLength": 3
    },
    "TLS_PROVIDER": {
      "type": "string",
      "enum": ["selfsigned", "none", "custom", "letsencrypt"]
    },
    "TLS_CUSTOM_FULLCHAIN_PATH": {
      "type": "string"
    },
    "TLS_CUSTOM_PRIVKEY_PATH": {
      "type": "string"
    },
    "BACKUP_FREQUENCY": {
      "type": "string",
      "enum": ["off", "daily", "weekly"]
    },
    "BACKUP_RETENTION_DAYS": {
      "type": "string",
      "pattern": "^[0-9]{1,3}$"
    },
    "CERTS_DIR": {
      "type": "string",
      "minLength": 1
    },
    "CERTS_WEBROOT_DIR": {
      "type": "string",
      "minLength": 1
    },
    "STARTUP_RUN_MIGRATIONS": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "RUN_BOOTSTRAP_SEEDER": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "SENTRY_DSN": {
      "type": "string"
    },
    "VITE_SENTRY_DSN": {
      "type": "string"
    },
    "FRONTEND_HTTP_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "FRONTEND_HTTPS_PORT": {
      "type": "string",
      "pattern": "^[0-9]{2,5}$"
    },
    "MAIL_HOST": {
      "type": "string"
    },
    "MAIL_PORT": {
      "type": "string"
    },
    "MAIL_USER": {
      "type": "string"
    },
    "MAIL_PASS": {
      "type": "string"
    },
    "MAIL_SECURE": {
      "type": "string"
    },
    "SEED_DEFAULT_ADMIN_EMAIL": {
      "type": "string"
    },
    "SEED_DEFAULT_SUPERADMIN_EMAIL": {
      "type": "string"
    }
  }
}
