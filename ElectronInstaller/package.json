{
  "name": "smarteconomat-installer",
  "version": "1.0.2",
  "description": "Instalador de SmartEconomat vía Docker",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild:project": "node ./scripts/pre-build-project.mjs",
    "build:project": "node ./scripts/pre-build-project.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:app && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build:app": "node ./scripts/ensure-win-icons.mjs && node ./scripts/maybe-electron-rebuild.mjs && electron-vite build",
    "build:win": "npm run build:win:fast",
    "build:win:fast": "node ./scripts/build-win-fast-local.mjs",
    "build:win:release": "npm run build:win:fast",
    "build:win:signed": "npm run build:win:fast && npm run verify:win:signature",
    "build:win:release:signed": "npm run build:win:signed",
    "sign:win:artifact": "node ./scripts/sign-windows-artifact.mjs",
    "verify:win:signature": "node ./scripts/verify-win-signature.mjs",
    "verify:win:icon": "node ./scripts/verify-win-exe-icon.mjs",
    "build:win:cleanup": "node ./scripts/kill-stuck-builds.mjs",
    "build:windows-from-linux": "node ./scripts/build-windows-from-linux.mjs",
    "build:win:linux": "npm run build:windows-from-linux",
    "build:mac": "node ./scripts/build-mac-safe.mjs",
    "build:linux": "npm run build:app && electron-builder --linux",
    "pack": "npm run build:app && electron-builder --dir",
    "build": "npm run build:app && node ./scripts/build-current-platform.mjs",
    "validate:env-template": "node ./scripts/validate-env-template.mjs",
    "fix:local-hosts": "node ./scripts/fix-local-hosts.mjs",
    "validate:local-domain": "node ./scripts/validate-local-domain.mjs",
    "analyze:artifacts": "node ./scripts/analyze-artifacts.mjs"
  },
  "author": "SmartEconomat",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dayjs": "^1.11.19",
    "electron-log": "^5.4.3",
    "nodemailer": "^8.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^2.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.18.12",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "playwright-core": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "yauzl": "^3.2.1"
  },
  "build": {
    "appId": "com.smarteconomat.installer",
    "productName": "SmartEconomat",
    "buildDependenciesFromSource": false,
    "compression": "store",
    "asar": true,
    "asarUnpack": [
      "out/preload/**/*"
    ],
    "icon": "resources/icons/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "resources/**/*",
      "scripts/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.spec.*",
      "!**/*.test.*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "resources/icons/win/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "warningsAsErrors": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartEconomat",
      "installerIcon": "resources/icons/nsis/installer.ico",
      "uninstallerIcon": "resources/icons/nsis/uninstaller.ico",
      "installerHeaderIcon": "resources/icons/nsis/installer.ico",
      "installerHeader": "resources/icons/nsis/installerHeader.bmp",
      "installerSidebar": "resources/icons/nsis/installerSidebar.bmp",
      "uninstallerSidebar": "resources/icons/nsis/uninstallerSidebar.bmp",
      "runAfterFinish": true,
      "include": "resources/nsis/installer-hooks.nsh"
    },
    "mac": {
      "icon": "resources/icons/mac/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "iconSize": 100,
      "window": {
        "width": 620,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 220,
          "type": "file"
        },
        {
          "x": 450,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "resources/icons/linux/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "System",
      "synopsis": "Instalador oficial de SmartEconomat",
      "description": "Instalador asistido para desplegar SmartEconomat con Docker y validaciones automáticas.",
      "executableName": "smarteconomat-installer"
    },
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../backend/smart-economat-backend",
        "to": "project/backend/smart-economat-backend",
        "filter": [
          "dist/**/*",
          "scripts/**/*",
          "package.json",
          "package-lock.json",
          "src/i18n/**/*",
          "src/seeders/datos-base-economato/**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../frontend/smart-economat-frontend",
        "to": "project/frontend/smart-economat-frontend",
        "filter": [
          "build/**/*",
          "nginx.conf",
          "nginx-http.conf",
          "docker-entrypoint.d/**/*",
          "package.json",
          "package-lock.json",
          "!**/*.map"
        ]
      },
      {
        "from": "../database",
        "to": "project/database",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/test/**",
          "!**/tests/**",
          "!**/.git/**",
          "!**/.github/**"
        ]
      },
      {
        "from": "../docker-compose.prod.yml",
        "to": "project/docker-compose.prod.yml"
      },
      {
        "from": "../backend/Dockerfile.prod",
        "to": "project/backend/Dockerfile.prod"
      },
      {
        "from": "../frontend/Dockerfile.prod",
        "to": "project/frontend/Dockerfile.prod"
      }
    ]
  }
}
