{
  "Supervisor": {
    "RuntimePath": "C:/SmartEconomatRuntime",
    "ComposeProjectDir": "C:/SmartEconomatRuntime/project",
    "ComposeFile": "C:/SmartEconomatRuntime/project/docker-compose.prod.yml",
    "EnvFile": "C:/SmartEconomatRuntime/.env.prod",
    "PublicDomain": "smarteconomat.app",
    "OpsScriptsPath": "",
    "WatchdogIntervalSeconds": 180,
    "ServiceCorrectionCooldownSeconds": 600,
    "ContainerRecoveryCooldownSeconds": 300,
    "DockerRecoveryCooldownSeconds": 900,
    "ComposeLightRecoveryCooldownSeconds": 600,
    "ComposeFullRecoveryCooldownSeconds": 900,
    "BootGraceSeconds": 300,
    "PersistenceThreshold": 3,
    "L1PersistenceThreshold": 2,
    "HealthTimeoutSeconds": 20,
    "HealthEndpointPath": "/",
    "BackendEndpointPath": "/api/v1",
    "ComposeRecoveryPolicy": "Progressive",
    "ExpectedServices": [ "frontend", "backend", "db", "redis" ]
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/SmartEconomat/logs/supervisor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "flushToDiskInterval": "00:00:02"
        }
      }
    ]
  }
}
