{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFilesAfterEnv": ["<rootDir>/test/setup-env.ts"],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/migrations/*.ts",
    "!src/**/*.seeder.ts",
    "!src/main.ts"
  ],
  "coverageDirectory": "coverage-e2e"
}
