{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/e2e/**/*.e2e-spec.ts",
    "<rootDir>/test/examples/**/*.e2e-spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2022",
          "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        },
        "module": {
          "type": "commonjs",
          "ignoreDynamic": true
        }
      }
    ]
  },
  "setupFilesAfterEnv": ["<rootDir>/test/setup/jest.setup.ts"],
  "globalSetup": "<rootDir>/test/globalSetup.ts",
  "globalTeardown": "<rootDir>/test/globalTeardown.ts",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^test/(.*)$": "<rootDir>/test/$1",
    "^(\\.\\.?/.*)\\.js$": "$1"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/migrations/*.ts",
    "!src/**/*.seeder.ts",
    "!src/main.ts"
  ],
  "coverageDirectory": "coverage-e2e",
  "testTimeout": 30000,
  "bail": false,
  "verbose": true
}
