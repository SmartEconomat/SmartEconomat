#!/bin/sh
echo "🔄 Running post-merge hooks"

echo "🧹 [1/3] Ejecutando linter después del merge..."
(cd backend/smart-economat-backend && npx eslint "{src,apps,libs,test}/**/*.ts" --fix)

echo "🔍 [2/3] Verificando tipos con TypeScript..."
(cd backend/smart-economat-backend && npx tsc --noEmit)

