#!/bin/sh

# Check if we are in the middle of a merge or rebase
if [ -d ".git/rebase-merge" ] || [ -d ".git/rebase-apply" ] || [ -f ".git/MERGE_HEAD" ]; then
    echo "⚠️ Skipping Husky hooks (merge/rebase in progress)"
    exit 0
fi

echo "🚀 Running pre-commit hooks"

echo "🧹 [1/3] Limpiando comentarios y verificando código (Backend)..."
# Usamos paréntesis para ejecutar en subshell y no afectar el directorio actual
(cd backend/smart-economat-backend && npx lint-staged && npx tsc --noEmit)

echo "📊 [2/3] Actualizando estadísticas de contribuidores..."
./scripts/contributors/count-commits.sh

echo "🧪 [3/3] Ejecutando tests E2E..."
(cd backend/smart-economat-backend && npm run test:e2e)
