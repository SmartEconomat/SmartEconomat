{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": true,
    "assets": ["i18n/**/*", "seeders/datos-base-economato/**/*"],
    "watchAssets": true
  },
  "watchOptions": {
    "ignored": [
      "node_modules",
      "dist",
      "coverage",
      "uploads",
      "**/*.spec.ts",
      "**/*.e2e-spec.ts",
      "test/**",
      "scripts/**",
      "tools/**"
    ]
  }
}
