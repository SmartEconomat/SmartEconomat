FROM node:22.2.0-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build
RUN npm prune --omit=dev && npm cache clean --force

FROM node:22.2.0-alpine AS production

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/i18n ./dist/i18n
COPY --from=builder /app/src/seeders/datos-base-economato ./dist/seeders/datos-base-economato
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Create user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Create uploads directory and give permissions to the appuser
RUN mkdir -p /app/uploads && chown -R appuser:appgroup /app/uploads

USER appuser

EXPOSE 3000

CMD ["npm", "run", "start:prod"]
