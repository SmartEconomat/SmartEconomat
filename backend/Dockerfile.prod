# syntax=docker/dockerfile:1.4
FROM node:22.2.0-alpine AS builder

WORKDIR /app

# Copy package files and install dependencies with caching
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund --cache /root/.npm

# Copy source and build
COPY . .
RUN npm run build

# Prune dev dependencies after successful build
RUN --mount=type=cache,target=/root/.npm \
    npm prune --omit=dev && npm cache clean --force

# ============================================================================
FROM node:22.2.0-alpine AS production

ARG BUILD_DATE=unknown
ARG VCS_REF=unknown
ARG VERSION=1.0.0

WORKDIR /app

# Copy built artifacts and dependencies
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/i18n ./dist/i18n
COPY --from=builder /app/src/seeders/datos-base-economato ./dist/seeders/datos-base-economato
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Copy scripts needed for production
COPY --from=builder /app/scripts/prod-bootstrap-runner.js ./scripts/prod-bootstrap-runner.js
COPY --from=builder /app/scripts/db-reset-runner.js ./scripts/db-reset-runner.js
COPY --from=builder /app/scripts/seed-runner.js ./scripts/seed-runner.js

# Create non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

LABEL org.opencontainers.image.title="SmartEconomat Backend"
LABEL org.opencontainers.image.description="NestJS backend runtime image"
LABEL org.opencontainers.image.version="$VERSION"
LABEL org.opencontainers.image.revision="$VCS_REF"
LABEL org.opencontainers.image.created="$BUILD_DATE"

# Create uploads directory with proper permissions
RUN mkdir -p /app/uploads && chown -R appuser:appgroup /app/uploads

# Switch to non-root user
USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/v1 || exit 1

# Use exec form for proper signal handling (PID 1)
ENTRYPOINT ["node", "scripts/prod-bootstrap-runner.js"]
CMD ["--", "node", "dist/main.js"]
