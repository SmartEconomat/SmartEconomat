FROM node:22.2.0-alpine

# Instalar dependencias del sistema necesarias para módulos nativos
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++ \
    dumb-init \
    su-exec

WORKDIR /app

# Borrar USER node de aquí, el entrypoint lo hará con su-exec
# Pero aseguramos que el código base sea del usuario node
COPY --chown=node:node package*.json ./

# Copiar el resto del código
COPY --chown=node:node . .

# Usar el script de entrypoint para corregir permisos en runtime
COPY scripts/docker-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["sh", "-c", "sh scripts/ensure-deps.sh && npm run start:dev"]


