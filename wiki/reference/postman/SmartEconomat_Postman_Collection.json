    {
      "name": "06. Pedidos",
      "item": [
        {
          "name": "Create Pedido",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proveedorId\": \"uuid-proveedor\",\n  \"productos\": [\n    {\n      \"productoProveedorId\": \"uuid-pp\",\n      \"cantidad\": 50,\n      \"precioUnitario\": 1.25\n    }\n  ],\n  \"fechaEntrega\": \"2026-04-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/pedidos"
          }
        },
        {
          "name": "List All",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/pedidos?page=1"
          }
        }
      ]
