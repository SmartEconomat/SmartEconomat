                "variable": [{ "key": "id", "value": "" }]
              }
            },
            {
              "name": "Permissions Management",
              "item": [
                {
                  "name": "Add Additional Permission",
                  "request": {
                    "method": "POST",
                    "url": "{{base_url}}/usuarios/:id/permisos-adicionales/:permisoId",
                    "variable": [
                      { "key": "id", "value": "" },
                      { "key": "permisoId", "value": "" }
