        },
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tortilla de Patatas\",\n  \"instrucciones\": \"1. Pelar...\",\n  \"tiempo\": \"30 min\",\n  \"dificultad\": \"Fácil\",\n  \"tiempoPreparacion\": \"10 min\",\n  \"ingredientes\": [\n    {\n      \"productoId\": \"uuid-patata\",\n      \"cantidad\": 1,\n      \"unidad\": \"KG\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
