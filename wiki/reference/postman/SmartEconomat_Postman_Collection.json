            "url": "{{base_url}}/productos/generar-ean13"
          }
        },
        {
          "name": "List Products (Search & Filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/productos?page=1&limit=20&searchTerm=leche&categorias=lacteo&alergenos=LACTEOS&minStock=true",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "searchTerm", "value": "leche", "disabled": true },
                {
                  "key": "codigoBarras",
                  "value": "8412345678901",
                  "disabled": true
                },
                { "key": "categorias", "value": "lacteo", "disabled": true },
                { "key": "alergenos", "value": "LACTEOS", "disabled": true },
                { "key": "minStock", "value": "true", "disabled": true }
              ]
            }
          }
        },
