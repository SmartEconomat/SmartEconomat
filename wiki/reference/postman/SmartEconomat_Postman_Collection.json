    {
      "name": "06. Pedidos",
      "item": [
        {
          "name": "Create Pedido",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proveedorId\": \"uuid-proveedor\",\n  \"observaciones\": \"Pedido semanal de economato\",\n  \"lineas\": [\n    {\n      \"productoProveedorId\": \"uuid-pp\",\n      \"cantidad\": 50\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/pedidos",
            "description": "Crea un pedido con estado inicial `PENDIENTE`. `fechaEntrega` se calcula automáticamente en backend con el offset configurado y el payload solo admite `proveedorId`, `lineas` y `observaciones`."
          }
        },
        {
          "name": "Create Pedido From Recipes",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recetaIds\": [\n    \"uuid-receta-1\",\n    \"uuid-receta-2\"\n  ],\n  \"observaciones\": \"Pedido generado desde recetas para producción semanal\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/pedidos/from-recipes",
            "description": "Genera un pedido único consolidando ingredientes de múltiples recetas. Requiere que exista un proveedor común con precio vigente para todos los productos consolidados."
          },
          "response": [
            {
              "name": "201 Created - Pedido consolidado",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"recetaIds\": [\n    \"uuid-receta-1\",\n    \"uuid-receta-2\"\n  ],\n  \"observaciones\": \"Pedido generado desde recetas para producción semanal\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{base_url}}/pedidos/from-recipes"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Operación exitosa\",\n  \"data\": {\n    \"id\": \"01959e4b-5f9a-7db1-94d6-6f3d0d3f0001\",\n    \"proveedorId\": \"01959e4b-5f9a-7db1-94d6-6f3d0d3f0100\",\n    \"usuarioId\": \"01959e4b-5f9a-7db1-94d6-6f3d0d3f0200\",\n    \"estado\": \"PENDIENTE\",\n    \"costeTotal\": 12,\n    \"pedidoProductos\": [\n      {\n        \"cantidad\": 3,\n        \"precioUnitario\": 4\n      }\n    ]\n  }\n}"
            },
            {
              "name": "400 Bad Request - Sin proveedor común",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"recetaIds\": [\n    \"uuid-receta-1\",\n    \"uuid-receta-2\"\n  ]\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{base_url}}/pedidos/from-recipes"
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"No existe un proveedor común activo para todos los ingredientes de las recetas seleccionadas.\",\n  \"data\": null\n}"
            },
            {
              "name": "404 Not Found - Receta inexistente",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwt_token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"recetaIds\": [\n    \"uuid-receta-valida\",\n    \"0191c30c-1e55-7000-8000-000000000000\"\n  ]\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{base_url}}/pedidos/from-recipes"
              },
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"No se encontraron las recetas: 0191c30c-1e55-7000-8000-000000000000\",\n  \"data\": null\n}"
            }
          ]
        },
        {
          "name": "List All",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/pedidos?page=1"
          }
        },
        {
          "name": "Get Pedido Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/pedidos/:id",
            "description": "Obtiene el detalle completo del pedido, incluyendo líneas consolidadas y proveedor.",
            "variable": [{ "key": "id", "value": "" }]
          }
        },
        {
          "name": "Update Fecha Entrega (rejected)",
          "request": {
            "method": "PATCH",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaEntrega\": \"2026-04-08T10:00:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/pedidos/:id/fecha-entrega",
            "description": "Endpoint mantenido por compatibilidad, pero en el flujo normal responde error porque `fechaEntrega` ya no se edita manualmente.",
            "variable": [{ "key": "id", "value": "" }]
          }
        },
        {
          "name": "Cancelar Pedido",
          "request": {
            "method": "PATCH",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivoCancelacion\": \"Cambio de planificación de cocina\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/pedidos/:id/cancelar",
            "description": "Cancela el pedido solo si no existe ninguna recepción vinculada. Si la recepción ya comenzó, backend devuelve error de regla de negocio.",
            "variable": [{ "key": "id", "value": "" }]
          }
        }
      ]
    },
    {
      "name": "07. Recepción",
      "item": [
        {
          "name": "Procesar Recepción Maestro",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidos\": [\n    {\n      \"pedidoId\": \"uuid-pedido-1\",\n      \"nAlbaran\": \"ALB-001/24\",\n      \"observaciones\": \"Entregado en muelle A\"\n    }\n  ],\n  \"nAlbaran\": \"ALB-GENERAL-001\",\n  \"observaciones\": \"Firma general del transportista\",\n  \"productos\": [\n    {\n      \"pedidoProductoId\": \"uuid-linea-pedido\",\n      \"cantidadRecibida\": 10,\n      \"cantidadAlbaran\": 10,\n      \"estadoVisual\": \"OPTIMO\",\n      \"fechaCaducidad\": \"2026-12-31T00:00:00Z\",\n      \"observaciones\": \"Lote revisado\"\n    }\n  ],\n  \"productosNuevos\": [\n    {\n      \"pendienteCreacion\": true,\n      \"codigoBarras\": \"8410188003028\",\n      \"nombre\": \"Tomate frito Orlando\",\n      \"marca\": \"Orlando\",\n      \"unidad\": \"UNIDAD\",\n      \"tipo\": \"otro\",\n      \"contenido\": 400,\n      \"cantidadRecibida\": 5,\n      \"observaciones\": \"Alta directa en descarga\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/recepcion",
            "description": "Endpoint crítico. Procesa stock, movimientos, cierra pedidos y puede crear productos on-the-fly. Soporta multi-pedidos."
          }
        },
        {
          "name": "List History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/recepcion"
          }
        }
      ]
    },
