    {
      "name": "11. Recetas",
      "item": [
        {
          "name": "List Recipes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/recetas?searchTerm=Tortilla",
              "query": [{ "key": "searchTerm", "value": "Tortilla" }]
            }
          }
        },
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tortilla de Patatas\",\n  \"instrucciones\": \"1. Pelar...\",\n  \"tiempo\": \"30 min\",\n  \"dificultad\": \"Fácil\",\n  \"tiempoPreparacion\": \"30 minutos\",\n  \"ingredientes\": [\n    {\n      \"productoId\": \"uuid-patata\",\n      \"cantidad\": 1,\n      \"unidad\": \"kg\",\n      \"mermaAplicada\": 10\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/recetas"
          }
        },
        {
          "name": "Duplicate Recipe",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceId\": \"uuid-receta-original\",\n  \"newName\": \"Tortilla de Patatas Vegana\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/recetas/duplicate"
          }
        },
        {
          "name": "Get Escandallo (Cost Calculation)",
