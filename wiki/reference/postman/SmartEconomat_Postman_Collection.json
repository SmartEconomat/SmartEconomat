    {
      "name": "03. Productos",
      "item": [
        {
          "name": "Generate EAN-13",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/productos/generar-ean13"
          }
        },
        {
          "name": "List Products (Search & Filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/productos?page=1&limit=20&searchTerm=leche&tipo=lacteo&alergenos=gluten&minStock=true",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "searchTerm", "value": "leche", "disabled": true },
                { "key": "codigoBarras", "value": "84123456789", "disabled": true },
                { "key": "tipo", "value": "lacteo", "disabled": true },
                { "key": "alergenos", "value": "gluten", "disabled": true },
                { "key": "minStock", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Product (+Providers)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Vino Tinto Rioja\",\n  \"marca\": \"Cune\",\n  \"descripcion\": \"Crianza 2020\",\n  \"unidad\": \"u\",\n  \"tipo\": \"bebida\",\n  \"contenido\": 0.75,\n  \"proveedores\": [\n    {\n      \"proveedorId\": \"uuid-proveedor\",\n      \"precioActual\": 6.50\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/productos"
          }
        },
        {
          "name": "Get Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/productos/:id",
            "variable": [{ "key": "id", "value": "" }]
          }
