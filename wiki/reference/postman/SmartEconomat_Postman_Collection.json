    {
      "name": "07. Recepción",
      "item": [
        {
          "name": "Procesar Recepción Maestro",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidos\": [\n    {\n      \"pedidoId\": \"uuid-pedido-1\",\n      \"nAlbaran\": \"ALB-001/24\",\n      \"observaciones\": \"Entregado en muelle A\"\n    }\n  ],\n  \"nAlbaran\": \"ALB-GENERAL-001\",\n  \"observaciones\": \"Firma general del transportista\",\n  \"productos\": [\n    {\n      \"pedidoProductoId\": \"uuid-linea-pedido\",\n      \"cantidadRecibida\": 10,\n      \"estadoVisual\": \"OPTIMO\",\n      \"fechaCaducidad\": \"2026-12-31T00:00:00Z\",\n      \"observaciones\": \"Lote revisado\"\n    }\n  ],\n  \"productosNuevos\": [\n    {\n      \"pendienteCreacion\": true,\n      \"codigoBarras\": \"8410188003028\",\n      \"nombre\": \"Tomate frito Orlando\",\n      \"marca\": \"Orlando\",\n      \"unidad\": \"u\",\n      \"tipo\": \"otro\",\n      \"contenido\": 400,\n      \"cantidadRecibida\": 5,\n      \"observaciones\": \"Alta directa en descarga\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/recepcion",
            "description": "Endpoint crítico. Procesa stock, movimientos, cierra pedidos y puede crear productos on-the-fly. Soporta multi-pedidos."
          }
        },
        {
          "name": "List History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/recepcion"
          }
        }
      ]
    },
