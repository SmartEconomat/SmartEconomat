{
  "info": {
    "_postman_id": "75c3214a-8e2b-4b2a-9e1a-96bad0e1f203",
    "name": "SmartEconomat API v1",
    "description": "Colección oficial SmartEconomat (v1). Basada en API.md y validada contra controladores NestJS. Incluye gestión de stock, FEFO, multi-pedidos y auditoría total.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Demo\",\n  \"username\": \"userdemo\",\n  \"password\": \"PasswordFuerte123!\",\n  \"email\": \"demo@example.com\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/auth/register",
            "description": "Registra un nuevo usuario. Por defecto queda Inactivo e Invitado hasta validación de administrador."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.access_token) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smarteconomat.com\",\n  \"password\": \"SmartEconomat2026!\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Inicia sesión. El token se guarda automáticamente en la variable {{jwt_token}}."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"uuid-token-recuperacion\",\n  \"newPassword\": \"NuevaSegura123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/reset-password"
          }
        },
        {
          "name": "Change Password (Authenticated)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"SmartEconomat2026!\",\n  \"newPassword\": \"NuevaSegura!123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/change-password"
          }
        }
      ]
    },
    {
