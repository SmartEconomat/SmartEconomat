            "method": "GET",
            "url": {
              "raw": "{{base_url}}/movimientos/historial?entityId=uuid-pp&type=entrada&startDate=2026-01-01",
              "query": [
                { "key": "entityId", "value": "uuid-pp", "description": "UUID ProductoProveedor" },
                { "key": "userId", "value": "", "disabled": true, "description": "UUID Usuario auditado" },
                { "key": "type", "value": "entrada" },
                { "key": "startDate", "value": "2026-01-01" }
