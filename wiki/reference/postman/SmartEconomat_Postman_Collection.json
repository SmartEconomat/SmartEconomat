  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"userdemo\",\n  \"password\": \"PasswordFuerte123!\",\n  \"email\": \"demo@example.com\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/auth/register",
            "description": "Registra un nuevo usuario. Por defecto queda Inactivo e Invitado hasta validación de administrador."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var token = (jsonData && jsonData.data && jsonData.data.access_token) || jsonData.access_token;",
                  "if (token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smarteconomat.com\",\n  \"password\": \"SmartEconomat2026!\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Inicia sesión. El token se guarda automáticamente en la variable {{jwt_token}}."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"uuid-token-recuperacion\",\n  \"newPassword\": \"NuevaSegura123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/reset-password"
          }
        },
        {
          "name": "Change Password (Authenticated)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"SmartEconomat2026!\",\n  \"newPassword\": \"NuevaSegura!123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/change-password"
          }
        }
      ]
    },
