FROM node:22.2.0-alpine AS builder

WORKDIR /app

ARG VITE_SENTRY_DSN
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

FROM nginx:alpine

RUN apk add --no-cache inotify-tools bash openssl

COPY --from=builder /app/build /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Watcher script to auto-reload Nginx on certificate updates
COPY smart-economat-frontend/scripts/nginx-cert-watcher.sh /docker-entrypoint.d/99-nginx-cert-watcher.sh
RUN chmod +x /docker-entrypoint.d/99-nginx-cert-watcher.sh

EXPOSE 80 443

CMD ["/bin/sh", "-c", "/docker-entrypoint.d/99-nginx-cert-watcher.sh & exec nginx -g 'daemon off;'"]
