FROM node:22.2.0-alpine AS builder

WORKDIR /app

ARG VITE_SENTRY_DSN
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/build /usr/share/nginx/html

COPY nginx.conf /opt/nginx-templates/default-ssl.conf.template
COPY nginx-http.conf /opt/nginx-templates/default-http.conf.template
COPY nginx-http.conf /etc/nginx/templates/default.conf.template
COPY docker-entrypoint.d/19-select-nginx-template.sh /docker-entrypoint.d/19-select-nginx-template.sh

RUN chmod +x /docker-entrypoint.d/19-select-nginx-template.sh

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
